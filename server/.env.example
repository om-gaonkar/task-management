# Daymark API - local development environment
# Copy this file to server/.env. These values are examples for localhost only.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/productivity_workspace

# Local-only signing secret. Replace with a newly generated random secret in every deployed environment.
SESSION_SECRET=daymark-local-development-secret-change-before-deployment-2026

# Local HTTP development: secure cookies are disabled. Production must use HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=false

# Google OAuth is optional. Add real Google Cloud OAuth credentials to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# SMTP is optional for local development. Without it, development email flows may expose a dev token.
# For real email delivery, configure a provider's SMTP host, username, password and sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary is optional. Add a real Cloudinary account to enable image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=daymark-development
